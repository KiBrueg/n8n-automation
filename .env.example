# ============================================================
# AI Automation Hub — core config
# Скопируй в .env и заполни. .env НИКОГДА не коммитим в git.
# ============================================================

# --- Домен / прокси ---
N8N_HOST=localhost                  # прод: n8n.<IP>.sslip.io или n8n.yourdomain.com
GATEWAY_HOST=localhost             # прод: api.<IP>.sslip.io или api.yourdomain.com
STATUS_HOST=localhost              # прод: status.<IP>.sslip.io (Uptime Kuma)
ACME_EMAIL=you@example.com         # email для Let's Encrypt (прод HTTPS)
TZ=Europe/Berlin

# --- Образ gateway (прод тянет из GitHub Container Registry) ---
# CI пушит сюда; формат: ghcr.io/<owner>/n8n-automation-gateway:latest
# Для первого запуска без registry можно не задавать — сработает build: ./gateway
GATEWAY_IMAGE=ghcr.io/kibrueg/n8n-automation-gateway:latest

# --- PostgreSQL ---
POSTGRES_DB=hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=change_me_strong_password

# --- n8n ---
# сгенерировать: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change_me_random_hex
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_admin_password

# --- Gateway (FastAPI) ---
GATEWAY_API_KEY=change_me_shared_secret   # n8n и каналы шлют его в заголовке X-API-Key
LOG_LEVEL=INFO

# ============================================================
# LLM / AI провайдеры — переключаются конфигом, без правки кода
# ============================================================

# Основной чат-провайдер: stub | ollama | openrouter
#   stub — demo без ключей (rule-based), работает сразу после docker compose up
#   ollama / openrouter — реальные LLM для прода
LLM_PROVIDER=stub
# Fallback, если основной недоступен (пусто = без fallback)
LLM_FALLBACK_PROVIDER=

# --- Ollama (локальный) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# --- OpenRouter (облако: Claude/GPT/др. одним ключом) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Транскрипция голоса: none | whisper_local | openai_whisper ---
TRANSCRIBE_PROVIDER=none
# whisper_local (faster-whisper в контейнере или внешний сервис)
WHISPER_BASE_URL=http://host.docker.internal:9000
WHISPER_MODEL=base
# openai_whisper (api.openai.com)
OPENAI_API_KEY=

# --- Поведение ядра ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2                    # retry при невалидном JSON / ошибке провайдера
DEFAULT_TRUST_LEVEL=draft            # read | draft | prod (прогрессивный уровень доверия)
